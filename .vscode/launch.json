    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "env": {
                "FASTAPI_APP": "run:app",
                "FASTAPI_DEBUG": "1"
            },
            "args": [
                "run:app",
                "--reload"
            ],
            "jinja": true
        }
    ]
}